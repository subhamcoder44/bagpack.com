</head>
<body class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-gray-100">
  <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="mx-auto max-w-md">
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2">
          <span class="text-2xl font-bold tracking-tight">Geomax</span>
        </a>
        <p class="text-gray-500 mt-2">Welcome back — please sign in or create an account.</p>
      </div>

      <!-- Card -->
      <div class="bg-white shadow-xl shadow-gray-200/40 ring-1 ring-gray-200 rounded-2xl overflow-hidden">
        <!-- Tabs -->
        <div class="flex">
          <button id="tab-login" type="button"></button>
          <button id="tab-register" type="button"></button>
        </div>

        <!-- Panels -->
        <div class="p-6 sm:p-8">
          <!-- Flash (optional) -->
          <% if (typeof flash !== 'undefined' && flash) { %>
            <div class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-green-700">
              <%= flash %>
            </div>
          <% } %>

          <!-- LOGIN -->
          <section id="panel-login">
            <h2 class="text-xl font-semibold mb-4">Sign in</h2>
            <form method="" action="" class="space-y-4">

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="login-email">Email</label>
                <input id="login-email" name="email" type="email" required
                       class="w-full rounded-xl border-gray-300 focus:border-gray-900 focus:ring-gray-900"
                       placeholder="you@example.com" />
              </div>
              <div>
                <div class="flex items-center justify-between">
                  <label class="block text-sm font-medium text-gray-700 mb-1" for="login-password">Password</label>
                  <a href="#" class="text-sm text-gray-600 hover:text-gray-900">Forgot?</a>
                </div>
                <input id="login-password" name="password" type="password" required
                       class="w-full rounded-xl border-gray-300 focus:border-gray-900 focus:ring-gray-900"
                       placeholder="••••••••" />
              </div>
              <div class="flex items-center justify-between">
                <label class="inline-flex items-center gap-2 text-sm text-gray-600">
                  <input type="checkbox" class="rounded border-gray-300 text-gray-900 focus:ring-gray-900" />
                  Remember me
                </label>
                <span class="text-xs text-gray-400">Secure by HTTPS</span>
              </div>
              <button type="submit"
                      class="w-full rounded-xl bg-gray-900 text-white py-3 font-medium hover:bg-black transition">
                Sign in
              </button>
            </form>
            <p class="mt-4 text-sm text-gray-600">
              New here?
              <a href="#"
                 onclick="document.getElementById('tab-register').click(); return false;"
                 class="font-medium text-gray-900 underline underline-offset-4">Create an account</a>.
            </p>
          </section>

          <!-- REGISTER -->
          <section id="panel-register" class="hidden">
            <h2 class="text-xl font-semibold mb-4">Create account</h2>
            <form method="" action="" class="space-y-4">
             
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="reg-name">Full name</label>
                <input id="reg-name" name="name" type="text" required
                       class="w-full rounded-xl border-gray-300 focus:border-gray-900 focus:ring-gray-900"
                       placeholder="Your name" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="reg-email">Email</label>
                <input id="reg-email" name="email" type="email" required
                       class="w-full rounded-xl border-gray-300 focus:border-gray-900 focus:ring-gray-900"
                       placeholder="you@example.com" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1" for="reg-password">Password</label>
                <input id="reg-password" name="password" type="password" minlength="6" required
                       class="w-full rounded-xl border-gray-300 focus:border-gray-900 focus:ring-gray-900"
                       placeholder="At least 6 characters" />
              </div>
              <button type="submit"
                      class="w-full rounded-xl bg-gray-900 text-white py-3 font-medium hover:bg-black transition">
                Create account
              </button>
            </form>
            <p class="mt-4 text-sm text-gray-600">
              Already have an account?
              <a href="#"
                 onclick="document.getElementById('tab-login').click(); return false;"
                 class="font-medium text-gray-900 underline underline-offset-4">Sign in</a>.
            </p>
          </section>
        </div>

        <!-- Divider -->
        <div class="px-6 sm:px-8 pb-6">
          <div class="relative">
            <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-200"></div></div>
            <div class="relative flex justify-center">
              <span class="bg-white px-3 text-xs text-gray-400">or</span>
            </div>
          </div>

          <!-- Social buttons (demo) -->
          <div class="mt-6 grid grid-cols-1 gap-3">
            <button class="w-full rounded-xl border border-gray-300 py-2.5 text-sm hover:bg-gray-50">Continue with Google</button>
            <button class="w-full rounded-xl border border-gray-300 py-2.5 text-sm hover:bg-gray-50">Continue with GitHub</button>
          </div>
        </div>
      </div>

      <p class="text-center text-xs text-gray-400 mt-6">
        By continuing, you agree to the Terms & Privacy Policy.
      </p>
    </div>
  </main>
</body>
</html>
