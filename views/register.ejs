<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Register</title>
</head>
<body class="bg-zinc-800">
    <H1 class="p-9 text-xl italic font-semibold text-white ">Create Account</H1>
    <form action="/user/register" method="POST" class="flex flex-col gap-4 p-9 text-black justify-center items-center  bg-white  rounded-md w-1/3 mx-auto h-96">
            <input type="text" name="username" placeholder="Name" class="p-2 rounded-md w-full border-2 border-black  ">
        <input type="email" name="email" placeholder="Email" class="p-2 rounded-md w-full border-2 border-black ">
        <input type="password" name="password" placeholder="Password" class="p-2 rounded-md w-full border-2 border-black ">
        <button type="submit" class="bg-blue-500 text-white p-2 rounded-md hover:bg-blue-600">Register</button>
    </form>
    
</body>
</html>