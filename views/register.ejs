<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Auth • Geomax</title>

  <!-- Tailwind CDN (good for dev) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // Optional: Tailwind config tweak (fonts, etc.)
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Inter', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>

